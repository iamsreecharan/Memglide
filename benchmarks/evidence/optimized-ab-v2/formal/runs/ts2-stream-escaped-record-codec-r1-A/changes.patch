+  const fields:string[]=[];
+  let field="";
+  for(let i=0;i<text.length;i++){
+    const character=text[i];
+    if(character==="\\"){
+      const escaped=text[++i];
+      if(escaped!=="|" && escaped!=="\\")throw new Error("invalid escape");
+      field+=escaped;
+    }else if(character==="|"){
+      fields.push(field);
+      field="";
+    }else{
