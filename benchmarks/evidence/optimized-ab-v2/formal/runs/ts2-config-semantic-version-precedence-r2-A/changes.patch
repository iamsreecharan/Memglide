+function parts(value: string): { core: string[]; prerelease: string[] } {
+  if (!/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$(?![\s\S])/.test(value)) {
+    throw new Error("invalid version");
+  }
+  const main = value.split("+")[0];
+  const dash = main.indexOf("-");
+  const prerelease = dash < 0 ? [] : main.slice(dash + 1).split(".");
+  if (prerelease.some(p => /^\d+$/.test(p) && p.length > 1 && p.startsWith("0"))) {
+    throw new Error("leading zero");
+  }
+  return { core: (dash < 0 ? main : main.slice(0, dash)).split("."), prerelease };
