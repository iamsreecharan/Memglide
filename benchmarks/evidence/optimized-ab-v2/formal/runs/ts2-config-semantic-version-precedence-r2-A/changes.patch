+
+// Canonical decimal strings can be compared exactly without numeric conversion.
+function compareNumeric(left: string, right: string): number {
+  if (left.length !== right.length) return left.length < right.length ? -1 : 1;
+  return left === right ? 0 : left < right ? -1 : 1;
+}
+
+export function compareVersions(left: string, right: string): number {
+  const a = parts(left);
+  const b = parts(right);
+  for (let i = 0; i < 3; i++) {
+    const order = compareNumeric(a.core[i], b.core[i]);
+    if (order !== 0) return order;
+  }
+  if (a.prerelease.length === 0 || b.prerelease.length === 0) {
+    return a.prerelease.length === b.prerelease.length ? 0 : a.prerelease.length === 0 ? 1 : -1;
+  }
+  for (let i = 0; i < Math.min(a.prerelease.length, b.prerelease.length); i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === y) continue;
+    const xNumeric = /^\d+$/.test(x);
+    const yNumeric = /^\d+$/.test(y);
+    if (xNumeric && yNumeric) return compareNumeric(x, y);
+    if (xNumeric !== yNumeric) return xNumeric ? -1 : 1;
+    return x < y ? -1 : 1;
+  }
+  return compareNumeric(String(a.prerelease.length), String(b.prerelease.length));
 }