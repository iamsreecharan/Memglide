+export function delayPlan(delays: number[], deadline: number): number[] {
+  if (!Number.isFinite(deadline) || deadline < 0 || delays.some(n => !Number.isFinite(n) || n < 0)) {
+    throw new Error("invalid delay");
+  }
+  const result: number[] = [];
+  let elapsed = 0;
+  for (let i = 0; i < delays.length; i++) {
+    const finish = elapsed + delays[i];
+    if (!Number.isFinite(finish)) throw new Error("overflow");
+    if (finish > deadline) break;
+    elapsed = finish;
+    result.push(i);
+  }
   return result;
 }