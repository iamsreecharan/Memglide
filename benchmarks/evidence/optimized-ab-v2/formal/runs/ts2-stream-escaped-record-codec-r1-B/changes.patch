 export function decodeRecord(text:string):string[]{
-  if(/\\(?:[^|\\]|$)/.test(text))throw new Error("invalid escape");
-  return text.split("|").map(part=>part.replace(/\\([|\\])/g,"$1"));
+  const fields: string[] = [];
+  let field = "";
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (char === "\\") {
+      const escaped = text[++i];
