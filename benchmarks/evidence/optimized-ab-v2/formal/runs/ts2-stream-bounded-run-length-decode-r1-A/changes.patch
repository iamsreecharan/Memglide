diff --git a/src/bounded_run_length_decode.ts b/src/bounded_run_length_decode.ts
index 1e1ff02..31a2fc1 100644
--- a/src/bounded_run_length_decode.ts
+++ b/src/bounded_run_length_decode.ts
@@ -3,5 +3,15 @@ export function decodeRuns(runs:Run[],maxItems:number):unknown[]{
   if(!Number.isSafeInteger(maxItems)||maxItems<0) throw new Error("bad cap");
   let size=0;
   for(const run of runs){if(!Number.isSafeInteger(run.count)||run.count<0)throw new Error("bad count");size+=run.count;if(size>maxItems||!Number.isSafeInteger(size))throw new Error("cap exceeded");}
-  return runs.flatMap(run=>Array(run.count).fill(run.value));
+  // JavaScript arrays cannot represent lengths above 2^32 - 1.
+  if(size>0xffffffff)throw new Error("output too large");
+  const output:unknown[]=new Array(size);
+  let index=0;
+  for(const run of runs){
+    for(let i=0;i<run.count;i++){
+      output[index++]=run.value!==null&&typeof run.value==="object"
+        ?structuredClone(run.value):run.value;
+    }
+  }
+  return output;
 }