+export function parseEnv(text: string): Record<string, string> {
+  const result: Record<string, string> = Object.create(null);
+  const escapes: Record<string, string> = {
+    n: "\n", r: "\r", t: "\t", "\\": "\\", '"': '"',
+  };
+  for (let line of text.split(/\r?\n/)) {
+    line = line.trim();
+    if (!line || line.startsWith("#")) continue;
+    line = line.replace(/^export\s+/, "");
+    const match = /^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$(?![\s\S])/.exec(line);
+    if (!match) throw new Error("invalid assignment");
+    const raw = match[2];
+    const quote = raw[0];
+    if (quote !== '"' && quote !== "'") {
+      result[match[1]] = raw.split("#")[0].trim();
+      continue;
+    }
+    let value = "";
+    let index = 1;
+    for (; index < raw.length && raw[index] !== quote; index++) {
+      const character = raw[index];
+      if (quote === '"' && character === "\\") {
+        const escaped = raw[++index];
+        if (!Object.hasOwn(escapes, escaped)) throw new Error("invalid escape");
+        value += escapes[escaped];
+      } else {
+        value += character;
+      }
+    }
+    if (index === raw.length) throw new Error("unterminated quote");
+    const remainder = raw.slice(index + 1).trim();
+    if (remainder && !remainder.startsWith("#")) throw new Error("invalid assignment");
+    result[match[1]] = value;
   }
   return result;
 }