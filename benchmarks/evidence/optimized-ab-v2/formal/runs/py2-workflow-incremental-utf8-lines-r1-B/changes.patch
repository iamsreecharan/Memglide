+
 def decode_lines(chunks):
-    text="".join(chunk.decode("utf-8") for chunk in chunks)
-    lines=text.split("\n")
-    if lines and lines[-1]=="": lines.pop()
-    return [line.removesuffix("\r") for line in lines]
+    """Decode strict UTF-8 chunks into LF-delimited lines."""
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    lines = []
+    fragments = []
+    for chunk in chunks:
+        parts = decoder.decode(chunk).split("\n")
+        for index, part in enumerate(parts):
+            if index:
+                lines.append("".join(fragments).removesuffix("\r"))
+                fragments = []
+            if part:
+                fragments.append(part)
+
+    # Finalizing rejects an incomplete codepoint at the end of the stream.
+    decoder.decode(b"", final=True)
+    if fragments:
+        lines.append("".join(fragments))
+    return lines