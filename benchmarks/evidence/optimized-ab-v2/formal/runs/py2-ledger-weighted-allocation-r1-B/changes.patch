--- a/ledger/weighted_allocation.py
+++ b/ledger/weighted_allocation.py
@@ -1,4 +1,12 @@
 def allocate(total, weights):
+    """Allocate cents by largest remainder, breaking ties by input order."""
     if type(total) is not int or total < 0 or not weights or any(type(w) is not int or w < 0 for w in weights) or sum(weights) == 0:
         raise ValueError("invalid allocation")
-    return [total * w // sum(weights) for w in weights]
+    total_weight = sum(weights)
+    shares = [divmod(total * weight, total_weight) for weight in weights]
+    result = [share for share, remainder in shares]
+    leftover = total - sum(result)
+    ranked = sorted(range(len(shares)), key=lambda i: (-shares[i][1], i))
+    for index in ranked[:leftover]:
+        result[index] += 1
+    return result