 def allocate(total, weights):
-    if type(total) is not int or total < 0 or not weights or any(type(w) is not int or w < 0 for w in weights) or sum(weights) == 0:
+    """Allocate integer cents by largest remainder, breaking ties by index."""
+    if type(total) is not int or total < 0 or not weights or any(type(w) is not int or w < 0 for w in weights):
         raise ValueError("invalid allocation")
-    return [total * w // sum(weights) for w in weights]
+    total_weight = sum(weights)
+    if total_weight == 0:
+        raise ValueError("invalid allocation")
+
+    shares = [divmod(total * w, total_weight) for w in weights]
+    allocation = [share for share, remainder in shares]
+    leftover = total - sum(allocation)
+    order = sorted(range(len(shares)), key=lambda i: (-shares[i][1], i))
+    for i in order[:leftover]:
+        allocation[i] += 1
+    return allocation