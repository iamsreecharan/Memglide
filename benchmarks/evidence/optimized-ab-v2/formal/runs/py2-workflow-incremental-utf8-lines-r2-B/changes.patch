+import codecs
+
+
 def decode_lines(chunks):
-    text="".join(chunk.decode("utf-8") for chunk in chunks)
-    lines=text.split("\n")
-    if lines and lines[-1]=="": lines.pop()
-    return [line.removesuffix("\r") for line in lines]
+    """Decode strict UTF-8 chunks into LF-delimited lines, normalizing CRLF."""
+    decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+    lines = []
+    fragments = []
+    for chunk in chunks:
+        parts = decoder.decode(chunk).split("\n")
+        for part in parts[:-1]:
+            fragments.append(part)
+            lines.append("".join(fragments).removesuffix("\r"))
+            fragments.clear()
+        if parts[-1]:
+            fragments.append(parts[-1])
+
+    # Finalization rejects an incomplete codepoint at the end of the stream.
+    fragments.append(decoder.decode(b"", final=True))
+    final_line = "".join(fragments)
+    if final_line:
+        lines.append(final_line)
+    return lines