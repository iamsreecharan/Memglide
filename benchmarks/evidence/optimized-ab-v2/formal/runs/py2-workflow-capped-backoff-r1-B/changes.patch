@@ -1,3 +1,13 @@
 def backoff(attempt, base, cap):
-    if any(type(n) is not int or n<0 for n in (attempt,base,cap)): raise ValueError("invalid backoff")
-    return min(cap,base*(attempt+1))
+    """Return the capped exponential delay for a zero-based retry attempt."""
+    if any(type(n) is not int or n < 0 for n in (attempt, base, cap)):
+        raise ValueError("invalid backoff")
+    if base == 0 or cap == 0:
+        return 0
+
+    # This is the first attempt whose delay reaches the cap. Check it before
+    # shifting so the size of intermediate integers never grows with attempt.
+    saturation_attempt = ((cap - 1) // base).bit_length()
+    if attempt >= saturation_attempt:
+        return cap
+    return base << attempt