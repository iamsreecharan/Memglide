        "command": "/bin/bash -lc \"cat > tests/strict_pointer_lookup.test.mjs <<'EOF'\nimport test from \\\"node:test\\\";\nimport assert from \\\"node:assert/strict\\\";\nimport { lookup as domainLookup } from \\\"../src/strict_pointer_lookup.ts\\\";\nimport { lookup as apiLookup } from \\\"../src/api.ts\\\";\n\nfor (const [name, lookup] of [[\\\"domain\\\", domainLookup], [\\\"api\\\", apiLookup]]) {\n  test(\"'`${name}: preserves falsy values and root primitives`, () => {\n    for (const value of [false, 0, \"\", null, undefined]) {\n      assert.equal(lookup({ value }, \"/value\"), value);\n      assert.equal(lookup([value], \"/0\"), value);\n      assert.equal(lookup(value, \"\"), value);\n      assert.throws(() => lookup({ value }, \"/value/child\"));\n    }\n  });\n\n  test(`${name}: decodes pointer tokens in order and rejects invalid escapes`, () => {\n    const document = { \"\": { \"a/b\": { \"~\": 0 } }, \"~1\": false };\n    assert.equal(lookup(document, \"//a~1b/~0\"), 0);\n    assert.equal(lookup(document, \"/~01\"), false);\n    for (const pointer of [\"a\", \"#/a\", \"/~\", \"/~2\", \"/a~1~x\"]) {\n      assert.throws(() => lookup(document, pointer));\n    }\n  });\n\n  test(`${name}: requires own keys and existing canonical array indices`, () => {\n    const document = Object.assign(Object.create({ inherited: 1 }), { own: 0 });\n    assert.equal(lookup(document, \"/own\"), 0);\n    for (const pointer of [\"/inherited\", \"/toString\", \"/missing\", \"/__proto__\"]) {\n      assert.throws(() => lookup(document, pointer));\n    }\n    assert.equal(lookup({ \"01\": false }, \"/01\"), false);\n    const array = [0, false];\n    assert.equal(lookup(array, \"/0\"), 0);\n    assert.equal(lookup(array, \"/1\"), false);\n    for (const key of [\"\", \"01\", \"-\", \"-1\", \"+0\", \"1.0\", \"1e0\", \" 0\", \"0'\"\\\\n\\\", \\\"2\\\", \\\"999999999999999999999\\\", \\\"length\\\"]) {\n      assert.throws(() => lookup(array, \"'`/${key}`));\n    }\n    assert.throws(() => lookup(new Array(1), \"/0\"));\n  });\n\n  test(`${name}: returns independent deep copies for root and nested values`, () => {\n    for (const pointer of [\"\", \"/nested\"]) {\n      const document = { nested: { items: [{ enabled: false }] } };\n      const result = lookup(document, pointer);\n      const selected = pointer === \"\" ? result.nested : result;\n      selected.items[0].enabled = true;\n      selected.items.push({ enabled: true });\n      assert.deepEqual(document, { nested: { items: [{ enabled: false }] } });\n    }\n  });\n}\nEOF\nnode --test tests/*.test.mjs'",
