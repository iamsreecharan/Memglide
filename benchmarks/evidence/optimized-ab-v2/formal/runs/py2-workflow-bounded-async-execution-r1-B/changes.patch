 import asyncio
-async def map_async(items,operation,concurrency):
-    if type(concurrency) is not int or concurrency<1: raise ValueError("bad concurrency")
-    return await asyncio.gather(*(operation(item) for item in items))
+
+
+async def map_async(items, operation, concurrency):
+    if type(concurrency) is not int or concurrency < 1:
+        raise ValueError("bad concurrency")
+
+    items = list(items)
+    results = [None] * len(items)
+    pending = iter(enumerate(items))
+    failed = False
+
+    async def worker():
+        nonlocal failed
+        while not failed:
+            try:
+                index, item = next(pending)
+            except StopIteration:
+                return
+            try:
+                results[index] = await operation(item)
+            except BaseException:
+                failed = True
+                raise
+
+    workers = [asyncio.create_task(worker())
+               for _ in range(min(concurrency, len(items)))]
+    try:
+        await asyncio.gather(*workers)
+    except BaseException:
+        for task in workers:
+            task.cancel()
+        await asyncio.gather(*workers, return_exceptions=True)
+        raise
+    return results