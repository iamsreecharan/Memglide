+    """Return the capped exponential delay, with the first attempt at zero."""
+    if any(type(n) is not int or n < 0 for n in (attempt, base, cap)):
+        raise ValueError("invalid backoff")
+    if base == 0 or cap == 0:
+        return 0
+    if base >= cap:
+        return cap
+    # Beyond this bound the shifted base necessarily exceeds the cap.
+    # Check before shifting so even enormous attempt counts stay cheap.
+    if attempt > cap.bit_length() - base.bit_length():
+        return cap
+    return min(cap, base << attempt)