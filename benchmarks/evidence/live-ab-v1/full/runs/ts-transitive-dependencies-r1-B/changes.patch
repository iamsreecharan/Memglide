 export function dependencies(graph: Record<string, string[]>, start: string): string[] {
-  return [...new Set(graph[start] ?? [])].filter(item => item !== start).sort();
+  const visited = new Set<string>([start]);
+  const pending = [start];
+  while (pending.length > 0) {
