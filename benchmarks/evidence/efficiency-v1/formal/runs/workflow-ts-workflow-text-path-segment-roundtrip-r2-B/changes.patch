diff --git a/tests/path_segment_roundtrip.test.mjs b/tests/path_segment_roundtrip.test.mjs
index aafa363..fa04fc9 100644
--- a/tests/path_segment_roundtrip.test.mjs
+++ b/tests/path_segment_roundtrip.test.mjs
@@ -7,3 +7,15 @@ test("ordinary-1",()=>{assert.equal(core.encodeSegment("a b"),"a%20b");});
 test("ordinary-2",()=>{assert.equal(api.buildPath([]),"/");});
 test("ordinary-3",()=>{assert.equal(api.buildPath(["a","b"]),"/a/b");});
 test("ordinary-4",()=>{assert.equal(api.buildPath(["A","b c"]),"/A/b%20c");});
+
+test("reserved characters stay inside one segment", () => {
+  assert.equal(core.encodeSegment("A/b?c#d"), "A%2Fb%3Fc%23d");
+  assert.equal(api.buildPath(["A/b", "c?d#e"]), "/A%2Fb/c%3Fd%23e");
+});
+
+test("empty segments and input order are preserved without mutation", () => {
+  const parts = Object.freeze(["", "B", "", "a", ""]);
+  assert.equal(api.buildPath(parts), "//B//a/");
+  assert.deepEqual(parts, ["", "B", "", "a", ""]);
+  assert.equal(api.buildPath(["", ""]), "//");
+});