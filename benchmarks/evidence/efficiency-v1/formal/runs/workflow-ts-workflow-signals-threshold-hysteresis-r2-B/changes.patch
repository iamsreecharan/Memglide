diff --git a/tests/threshold_hysteresis.test.mjs b/tests/threshold_hysteresis.test.mjs
index 1d6bb7e..cf81360 100644
--- a/tests/threshold_hysteresis.test.mjs
+++ b/tests/threshold_hysteresis.test.mjs
@@ -7,3 +7,27 @@ test("ordinary-1",()=>{assert.equal(core.nextState(false,6,2,5),true);});
 test("ordinary-2",()=>{assert.deepEqual(api.traceStates([],2,5),[]);});
 test("ordinary-3",()=>{assert.deepEqual(api.traceStates([0,1],2,5),[false,false]);});
 test("ordinary-4",()=>{assert.deepEqual(api.traceStates([6,7,0],2,5),[true,true,false]);});
+
+test("threshold boundaries and dead band respect the current state", () => {
+  for (const [value, inactive, active] of [
+    [1, false, false],
+    [2, false, false],
+    [3, false, true],
+    [5, true, true],
+    [6, true, true],
+  ]) {
+    assert.equal(core.nextState(false, value, 2, 5), inactive);
+    assert.equal(core.nextState(true, value, 2, 5), active);
+  }
+});
+
+test("trace carries state through repeated transitions without changing values", () => {
+  const values = Object.freeze([3, 5, 4, 2, 3, 6, 1]);
+  assert.deepEqual(api.traceStates(values, 2, 5), [false, true, true, false, false, true, false]);
+  assert.deepEqual(values, [3, 5, 4, 2, 3, 6, 1]);
+});
+
+test("trace respects an initially active state", () => {
+  assert.deepEqual(api.traceStates([3, 2, 4, 5], 2, 5, true), [true, false, false, true]);
+  assert.deepEqual(api.traceStates([], 2, 5, true), []);
+});