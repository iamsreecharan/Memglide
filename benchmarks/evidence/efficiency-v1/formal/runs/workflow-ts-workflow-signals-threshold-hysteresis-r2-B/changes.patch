diff --git a/src/threshold_hysteresis_api.ts b/src/threshold_hysteresis_api.ts
index 4200190..ddc63f1 100644
--- a/src/threshold_hysteresis_api.ts
+++ b/src/threshold_hysteresis_api.ts
@@ -1,6 +1,6 @@
 import {nextState} from "./threshold_hysteresis.ts";
 
 export function traceStates(values: number[], low: number, high: number, initial = false): boolean[] {
-  let state = false;
+  let state = initial;
   return values.map(value => { state = nextState(state, value, low, high); return state; });
