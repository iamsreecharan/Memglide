diff --git a/src/circular_angle_difference.ts b/src/circular_angle_difference.ts
index f4e9265..383231c 100644
--- a/src/circular_angle_difference.ts
+++ b/src/circular_angle_difference.ts
@@ -1,4 +1,8 @@
 export function angleDifference(from: number, to: number): number {
   if (!Number.isFinite(from) || !Number.isFinite(to)) throw new RangeError("finite angles required");
-  return (to - from) % 360;
+  const difference = (to % 360) - (from % 360);
+  const wrapped = difference % 360;
+  if (wrapped >= 180) return wrapped - 360;
+  if (wrapped < -180) return wrapped + 360;
+  return wrapped === 0 ? 0 : wrapped;
 }
diff --git a/tests/circular_angle_difference.test.mjs b/tests/circular_angle_difference.test.mjs
index 358ccdf..5c6c692 100644
--- a/tests/circular_angle_difference.test.mjs
+++ b/tests/circular_angle_difference.test.mjs
@@ -6,3 +6,36 @@ test("ordinary-1",()=>{assert.equal(core.angleDifference(10,30),20);});
 test("ordinary-2",()=>{assert.equal(core.angleDifference(30,10),-20);});
 test("ordinary-3",()=>{assert.equal(core.angleDifference(0,90),90);});
 test("ordinary-4",()=>{assert.equal(core.angleDifference(5.5,6),0.5);});
+
+test("shortest rotations wrap in both directions", () => {
+  assert.equal(core.angleDifference(350, 10), 20);
+  assert.equal(core.angleDifference(10, 350), -20);
+  assert.equal(core.angleDifference(-350, -10), -20);
+  assert.equal(core.angleDifference(359.75, 0.25), 0.5);
+});
+
+test("half turns always return negative 180", () => {
+  for (const to of [180, -180, 540, -540]) {
+    assert.equal(core.angleDifference(0, to), -180);
+    assert.equal(core.angleDifference(to, 0), -180);
+  }
+});
+
+test("full turns normalize to positive zero", () => {
+  for (const [from, to] of [[0, 360], [0, -360], [720, -720], [-0, 0]]) {
+    assert.equal(core.angleDifference(from, to), 0);
+  }
+});
+
+test("finite operands are normalized before potentially overflowing subtraction", () => {
+  assert.equal(core.angleDifference(-Number.MAX_VALUE, Number.MAX_VALUE), -104);
+  assert.equal(core.angleDifference(Number.MAX_VALUE, -Number.MAX_VALUE), 104);
+  assert.equal(core.angleDifference(Number.MAX_VALUE, Number.MAX_VALUE), 0);
+});
+
+test("nonfinite angles are rejected in either position", () => {
+  for (const value of [NaN, Infinity, -Infinity]) {
+    assert.throws(() => core.angleDifference(value, 0), RangeError);
+    assert.throws(() => core.angleDifference(0, value), RangeError);
+  }
+});