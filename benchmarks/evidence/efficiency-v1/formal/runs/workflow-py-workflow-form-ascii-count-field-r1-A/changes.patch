diff --git a/form/ascii_count_field.py b/form/ascii_count_field.py
index 0a0af31..3b8ab9f 100644
--- a/form/ascii_count_field.py
+++ b/form/ascii_count_field.py
@@ -1,5 +1,8 @@
 def parse_count(text):
     """Read the integer field accepted by a legacy ASCII-only form protocol."""
-    if not text or not text.isdigit():
+    if not text or any(char < "0" or char > "9" for char in text):
         raise ValueError("ASCII digits required")
-    return int(text)
+    value = 0
+    for char in text:
+        value = value * 10 + ord(char) - ord("0")
+    return value
diff --git a/tests/test_ascii_count_field.py b/tests/test_ascii_count_field.py
index 637a1fc..a7033b2 100644
--- a/tests/test_ascii_count_field.py
+++ b/tests/test_ascii_count_field.py
@@ -17,3 +17,19 @@ class OrdinaryTests(unittest.TestCase):
     def test_ordinary_4(self):
         self.assertEqual(core.parse_count("123456789"),123456789)
 
+
+class RegressionTests(unittest.TestCase):
+    def test_rejects_non_ascii_digits_and_other_characters(self):
+        for text in ("", "١", "１２", "²", "1٢", "+1", "-1", " 1", "1 ", "1\n", "1_0", "1.0"):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    core.parse_count(text)
+
+    def test_accepts_all_ascii_digits(self):
+        self.assertEqual(core.parse_count("0123456789"), 123456789)
+
+    def test_large_integer_remains_exact(self):
+        self.assertEqual(core.parse_count("1" + "0" * 5000), 10 ** 5000)
+
+    def test_many_leading_zeros(self):
+        self.assertEqual(core.parse_count("0" * 5000 + "7"), 7)