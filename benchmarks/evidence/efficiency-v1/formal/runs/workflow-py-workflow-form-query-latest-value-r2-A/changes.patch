+class RegressionTests(unittest.TestCase):
+    def test_latest_values_preserves_first_key_order_and_input(self):
+        pairs = [("b", "first"), ("a", "second"), ("b", "last"),
+                 ("B", "uppercase"), ("a", "")]
+        original = list(pairs)
+        result = core.latest_values(pairs)
+        self.assertEqual(list(result.items()),
+                         [("b", "last"), ("a", ""), ("B", "uppercase")])
+        self.assertEqual(pairs, original)
+
+    def test_query_uses_exact_key_and_preserves_latest_value(self):
+        pairs = [("Name", "old"), ("name", "lowercase"),
+                 ("Name", "  MiXeD  "), ("empty", "")]
+        original = list(pairs)
+        self.assertEqual(api.query_value(pairs, "Name"), "  MiXeD  ")
+        self.assertEqual(api.query_value(pairs, "name"), "lowercase")
+        self.assertEqual(api.query_value(pairs, "NAME", "  Default  "),
+                         "  Default  ")
+        self.assertEqual(api.query_value(pairs, "empty", "fallback"), "")
+        self.assertEqual(pairs, original)
+
+    def test_query_returns_caller_default_unchanged(self):
+        default = object()
+        self.assertIs(api.query_value([], "missing", default), default)