+
+test("UTF-8 byte lengths", () => {
+  for (const [text, expected] of [
+    ["é", 2],
+    ["中文", 6],
+    ["😀", 4],
+    ["aé中😀", 10],
+    ["\uD800", 3],
+    ["\uDC00", 3],
+    ["\uD800a\uDC00", 7],
+    ["\uD800\uD800\uDC00", 7],
+  ]) {
+    assert.equal(core.utf8Size(text), expected, JSON.stringify(text));
+  }
+});