diff --git a/src/circular_angle_difference.ts b/src/circular_angle_difference.ts
index f4e9265..f4a8a1f 100644
--- a/src/circular_angle_difference.ts
+++ b/src/circular_angle_difference.ts
@@ -1,4 +1,7 @@
 export function angleDifference(from: number, to: number): number {
   if (!Number.isFinite(from) || !Number.isFinite(to)) throw new RangeError("finite angles required");
-  return (to - from) % 360;
+  let difference = ((to % 360) - (from % 360)) % 360;
+  if (difference >= 180) difference -= 360;
+  if (difference < -180) difference += 360;
+  return difference === 0 ? 0 : difference;
 }
diff --git a/tests/circular_angle_difference.test.mjs b/tests/circular_angle_difference.test.mjs
index 358ccdf..84e4a85 100644
--- a/tests/circular_angle_difference.test.mjs
+++ b/tests/circular_angle_difference.test.mjs
@@ -6,3 +6,27 @@ test("ordinary-1",()=>{assert.equal(core.angleDifference(10,30),20);});
 test("ordinary-2",()=>{assert.equal(core.angleDifference(30,10),-20);});
 test("ordinary-3",()=>{assert.equal(core.angleDifference(0,90),90);});
 test("ordinary-4",()=>{assert.equal(core.angleDifference(5.5,6),0.5);});
+
+test("shortest signed rotation and half-open boundary", () => {
+  for (const [from, to, expected] of [
+    [350, 10, 20], [10, 350, -20],
+    [0, 180, -180], [180, 0, -180],
+    [720, -720, 0], [0, -360, 0],
+    [-725.5, 725.25, 10.75], [0, -180.25, 179.75],
+    [0, 179.99999999999997, 179.99999999999997],
+  ]) {
+    assert.equal(core.angleDifference(from, to), expected);
+  }
+});
+
+test("normalizes large operands before subtraction can overflow", () => {
+  assert.equal(core.angleDifference(-Number.MAX_VALUE, Number.MAX_VALUE), -104);
+  assert.equal(core.angleDifference(Number.MAX_VALUE, -Number.MAX_VALUE), 104);
+});
+
+test("rejects nonfinite inputs", () => {
+  for (const value of [NaN, Infinity, -Infinity]) {
+    assert.throws(() => core.angleDifference(value, 0), RangeError);
+    assert.throws(() => core.angleDifference(0, value), RangeError);
+  }
+});