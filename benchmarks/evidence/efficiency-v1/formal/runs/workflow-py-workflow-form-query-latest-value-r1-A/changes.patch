@@ -18,3 +18,26 @@ class OrdinaryTests(unittest.TestCase):
     def test_ordinary_4(self):
         self.assertEqual(api.query_value([],"a","missing"),"missing")
 
+class RegressionTests(unittest.TestCase):
+    def test_latest_values_preserves_first_key_order_and_input(self):
+        pairs = [("B", "first"), ("a", "middle"), ("B", "Last Value"),
+                 ("b", "distinct"), ("a", "")]
+        original = pairs.copy()
+        result = core.latest_values(pairs)
+        self.assertEqual(list(result.items()),
+                         [("B", "Last Value"), ("a", ""), ("b", "distinct")])
+        self.assertEqual(pairs, original)
+
+    def test_query_uses_exact_key_and_latest_unchanged_value(self):
+        pairs = [("Field", "old"), ("field", "lower"),
+                 ("Field", "  Mixed CASE  ")]
+        original = pairs.copy()
+        self.assertEqual(api.query_value(pairs, "Field"), "  Mixed CASE  ")
+        self.assertEqual(api.query_value(pairs, "field"), "lower")
+        self.assertEqual(api.query_value(pairs, "FIELD", "  Default  "),
+                         "  Default  ")
+        self.assertEqual(pairs, original)
+
+    def test_empty_value_does_not_use_default(self):
+        self.assertEqual(api.query_value([("a", "old"), ("a", "")],
+                                         "a", "missing"), "")