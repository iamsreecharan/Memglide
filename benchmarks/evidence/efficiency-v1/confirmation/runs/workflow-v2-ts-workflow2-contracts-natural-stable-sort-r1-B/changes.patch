diff --git a/src/natural_stable_sort.ts b/src/natural_stable_sort.ts
index 4ad7878..9e4b01f 100644
--- a/src/natural_stable_sort.ts
+++ b/src/natural_stable_sort.ts
@@ -1,3 +1,24 @@
 export function compareNatural(left: string,right: string): number {
-  return left < right ? -1 : left > right ? 1 : 0;
+  const leftRuns = left.match(/[0-9]+|[^0-9]+/g) ?? [];
+  const rightRuns = right.match(/[0-9]+|[^0-9]+/g) ?? [];
+
+  for (let index = 0; index < Math.min(leftRuns.length, rightRuns.length); index++) {
+    let leftRun = leftRuns[index];
+    let rightRun = rightRuns[index];
+
+    if (/^[0-9]/.test(leftRun) && /^[0-9]/.test(rightRun)) {
+      leftRun = leftRun.replace(/^0+/, "");
+      rightRun = rightRun.replace(/^0+/, "");
+      // Equal-length decimal strings have the same order as their integer values.
+      if (leftRun.length !== rightRun.length) {
+        return leftRun.length < rightRun.length ? -1 : 1;
+      }
+    }
+
+    if (leftRun !== rightRun) {
+      return leftRun < rightRun ? -1 : 1;
+    }
+  }
+
+  return leftRuns.length < rightRuns.length ? -1 : leftRuns.length > rightRuns.length ? 1 : 0;
 }
