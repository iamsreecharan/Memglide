diff --git a/src/natural_stable_sort.ts b/src/natural_stable_sort.ts
index 4ad7878..2d72f8f 100644
--- a/src/natural_stable_sort.ts
+++ b/src/natural_stable_sort.ts
@@ -1,3 +1,17 @@
 export function compareNatural(left: string,right: string): number {
-  return left < right ? -1 : left > right ? 1 : 0;
+  const leftRuns = left.match(/[0-9]+|[^0-9]+/g) ?? [];
+  const rightRuns = right.match(/[0-9]+|[^0-9]+/g) ?? [];
+  for (let i = 0; i < Math.min(leftRuns.length, rightRuns.length); i++) {
+    let a = leftRuns[i];
+    let b = rightRuns[i];
+    if (/^[0-9]/.test(a) && /^[0-9]/.test(b)) {
+      // Canonical digit strings preserve exact values even beyond safe integers.
+      a = a.replace(/^0+/, "");
+      b = b.replace(/^0+/, "");
+      if (a.length !== b.length) return a.length < b.length ? -1 : 1;
+    }
+    if (a !== b) return a < b ? -1 : 1;
+  }
+  return leftRuns.length < rightRuns.length ? -1
+    : leftRuns.length > rightRuns.length ? 1 : 0;
 }
