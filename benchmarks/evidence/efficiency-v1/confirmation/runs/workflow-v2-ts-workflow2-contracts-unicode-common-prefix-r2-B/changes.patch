--- a/src/unicode_common_prefix.ts
+++ b/src/unicode_common_prefix.ts
@@ -1,3 +1,15 @@
 export function commonPrefix(values: string[]): string {
-  return values[0] ?? "";
+  const prefix = Array.from(values[0] ?? "");
+  let length = prefix.length;
+
+  for (let i = 1; i < values.length && length > 0; i++) {
+    let matched = 0;
+    for (const point of values[i]) {
+      if (matched === length || point !== prefix[matched]) break;
+      matched++;
+    }
+    length = matched;
+  }
+
+  return prefix.slice(0, length).join("");
 }