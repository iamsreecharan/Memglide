 def normalize_tags(tags):
     """Produce stable normalized tags for a catalog card."""
-    return [tag.strip().lower() for tag in tags if tag.strip()]
+    normalized = []
+    seen = set()
+    for tag in tags:
+        tag = tag.strip().casefold()
+        if tag and tag not in seen:
+            seen.add(tag)
+            normalized.append(tag)
+    return normalized
