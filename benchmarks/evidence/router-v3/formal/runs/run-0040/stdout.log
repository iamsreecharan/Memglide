}\\n  if (\\n    value[0] === '\\\"' &&\\n    value[value.length - 1] === '\\\"' &&\\n    value.indexOf(\\\"\\\\\\\\\\\") === -1\\n  ) {\\n    return value.slice(1, -1) as T;\\n  }\\n\\n  const _value = value.trim();\\n\\n  if (_value.length <= 9) {\\n    switch (_value.toLowerCase()) {\\n      case \\\"true\\\": {\\n        return true as T;\\n      }\\n      case \\\"false\\\": {\\n        return false as T;\\n      }\\n      case \\\"undefined\\\": {\\n        return undefined as T;\\n      }\\n      case \\\"null\\\": {\\n        return null as T;\\n      }\\n      case \\\"nan\\\": {\\n        return Number.NaN as T;\\n      }\\n      case \\\"infinity\\\": {\\n        return Number.POSITIVE_INFINITY as T;\\n      }\\n      case \\\"-infinity\\\": {\\n        return Number.NEGATIVE_INFINITY as T;\\n      }\\n    }\\n  }\\n\\n  if (!JsonSigRx.test(value)) {\\n    if (options.strict) {\\n      throw new SyntaxError(\\\"[destr] Invalid JSON\\\");\\n    }\\n    return value as T;\\n  }\\n\\n  try {\\n    if (suspectProtoRx.test(value) || suspectConstructorRx.test(value)) {\\n      if (options.strict) {\\n        throw new Error(\\\"[destr] Possible prototype pollution\\\");\\n      }\\n      return JSON.parse(value, jsonParseTransform);\\n    }\\n    return JSON.parse(value);\\n  } catch (error) {\\n    if (options.strict) {\\n      throw error;\\n    }\\n    return value as T;\\n  }\\n}\\n\\nexport function safeDestr<T = unknown>(value: any, options: Options = {}): T {\\n  return destr<T>(value, { ...options, strict: true });\\n}\\n\\nexport default destr;\\n\"}]}\n\nTask:\nReview strict JSON parsing so malformed inputs and prototype-pollution keys are rejected, while permissive parsing retains its fallback behavior. Trace strict-option propagation and dangerous-key handling in the maintained implementation.", "prompt_layout": "source_prefix", "reason": "explicit_focus", "task_prompt_sha256": "acdda6871911ae065431cc627144245fc39c46d69c7a52e877cce039ba3656f2"}, "re