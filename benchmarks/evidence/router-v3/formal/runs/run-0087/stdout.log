\\\"nan\\\": {\\n        return Number.NaN as T;\\n      }\\n      case \\\"infinity\\\": {\\n        return Number.POSITIVE_INFINITY as T;\\n      }\\n      case \\\"-infinity\\\": {\\n        return Number.NEGATIVE_INFINITY as T;\\n      }\\n    }\\n  }\\n\\n  if (!JsonSigRx.test(value)) {\\n    if (options.strict) {\\n      throw new SyntaxError(\\\"[destr] Invalid JSON\\\");\\n    }\\n    return value as T;\\n  }\\n\\n  try {\\n    if (suspectProtoRx.test(value) || suspectConstructorRx.test(value)) {\\n      if (options.strict) {\\n        throw new Error(\\\"[destr] Possible prototype pollution\\\");\\n      }\\n      return JSON.parse(value, jsonParseTransform);\\n    }\\n    return JSON.parse(value);\\n  } catch (error) {\\n    if (options.strict) {\\n      throw error;\\n    }\\n    return value as T;\\n  }\\n}\\n\\nexport function safeDestr<T = unknown>(value: any, options: Options = {}): T {\\n  return destr<T>(value, { ...options, strict: true });\\n}\\n\\nexport default destr;\\n\"}]}\n\nTask:\nReview strict JSON parsing so malformed inputs and prototype-pollution keys are rejected, while permissive parsing retains its fallback behavior. Trace strict-option propagation and dangerous-key handling in the maintained implementation.", "prompt_layout": "source_prefix", "reason": "automatic_verified_source", "task_prompt_sha256": "acdda6871911ae065431cc627144245fc39c46d69c7a52e877cce039ba3656f2"}, "resources": {"max_waited_child_rss_bytes": 20930560, "self_peak_rss_bytes": 20930560, "waited_child_cpu_seconds": 0.125173}, "setup": {"cpu_seconds": 0.052850843999999994, "waited_child_cpu_seconds": 0.066328, "wall_seconds": 0.14352237200000673}, "source_mutations": "", "timing": {"cpu_seconds": 0.05958212099999999, "waited_child_cpu_seconds": 0.05884500000000001, "wall_seconds": 0.119735578000018}}
